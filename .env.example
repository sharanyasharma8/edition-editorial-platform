# Next.js
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false # Set true behind HTTPS in production
DEMO_EDITOR_EMAIL=editor@edition.studio
DEMO_EDITOR_PASSWORD=edition-demo-pass
DEMO_AUTHOR_EMAIL=author@edition.studio
DEMO_AUTHOR_PASSWORD=author-demo-pass

# Enable the durable PostgreSQL repository after starting docker compose.
EDITION_USE_DB=false
DATABASE_URL=postgresql://edition:edition_local_pw@localhost:5432/edition?schema=public

# Optional Redis cache. The application gracefully degrades when unavailable.
REDIS_URL=redis://localhost:6379

# Optional Python AI service. Without it, the UI uses clearly-labelled demo suggestions.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=replace-with-a-long-random-internal-service-token
AI_PROVIDER=demo
# External model requests require BOTH this server-side flag and per-request editor consent.
AI_EXTERNAL_PROCESSING_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional object storage adapter settings for production media uploads.
AWS_REGION=ap-south-1
S3_MEDIA_BUCKET=
MEDIA_BASE_URL=
